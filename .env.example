# .env.example for movo-voice-demo. Copy to .env (gitignored) and fill the lines marked FILL.
# Never commit .env. Values here are placeholders or safe defaults.
# Model ids verified on docs.livekit.io/agents/models on 2026-11-07.

# ---------- LiveKit Cloud (FILL, core) ----------
# LiveKit Cloud > project movo-voice-demo > Settings > Keys. URL looks like wss://<project>-<hash>.livekit.cloud
LIVEKIT_URL=                       # FILL  wss://... from the project settings page
LIVEKIT_API_KEY=                   # FILL  starts with API...
LIVEKIT_API_SECRET=                # FILL  long random string shown once when the key is created

# Agent worker name. The SIP dispatch rule and the web token endpoint dispatch to this name.
AGENT_NAME=enroll-agent

# ---------- LiveKit Inference model ids (defaults, no key needed beyond LIVEKIT_API_KEY) ----------
# Format: provider/model or provider/model:voice. Cheapest configured set for development.
LK_STT_MODEL=deepgram/nova-3                # alternative: deepgram/flux-general-en
LK_LLM_MODEL=openai/gpt-6.1-terra           # current OpenAI balanced tier (1.00/5.00 USD per M tokens on LiveKit)
# Cheaper swap for development if credit runs low: openai/gpt-6-luna (0.10/0.50). LiveKit's own default: google/gemma-4-31b-it
LK_TTS_MODEL=deepgram/aura-2:athena         # development voice; recording voice below
# Recording voice. Swap in before the final recording only (CLAUDE.md rule 12).
# Voice id is the one shown in the LiveKit Cartesia docs; pick another from play.cartesia.ai/voices if wanted.
LK_TTS_MODEL_RECORDING=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# ---------- Supabase Postgres (FILL, core) ----------
# Supabase > project > Connect. Transaction pooler (port 6543) for the app, direct (port 5432) for migrations.
# The app sets prepare: false on the pooler connection (postgres.js), see db/index.ts.
DATABASE_URL=                      # FILL  postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Supabase direct hosts are IPv6-only; from an IPv4-only machine use the Session pooler (same pooler host, port 5432).
DIRECT_DATABASE_URL=               # FILL  postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Isolated test database for pnpm test:db only. Default: schema "test" on the same project, set by the agent.
# Same as DIRECT_DATABASE_URL plus ?options=-c%20search_path%3Dtest ; the agent writes this line.
TEST_DATABASE_URL=                 # agent fills after creating the test schema

# ---------- Braintrust (FILL, core) ----------
# braintrust.dev > Settings > API keys. Project is created on first log if missing.
BRAINTRUST_API_KEY=                # FILL  starts with sk-...
BRAINTRUST_PROJECT=movo-voice-demo

# ---------- Eval judge and simulated caller (FILL one of the two, core) ----------
# Used only by eval/ and the SDK's LLM judge in tests. Never used inside the voice pipeline.
OPENAI_API_KEY=                    # FILL  sk-... (default choice, see eval/run.ts)
ANTHROPIC_API_KEY=                 # optional alternative; leave empty if OPENAI_API_KEY is set
EVAL_JUDGE_MODEL=gpt-6.1-terra     # LLM judge (quality matters)
EVAL_CALLER_MODEL=gpt-6-luna       # simulated caller (many turns, cheap)

# ---------- Feature flags (default off; credentials below are validated only when on) ----------
FEATURE_SMS=false
FEATURE_OUTBOUND=false

# ---------- Twilio trial (optional, Phase 9 and SMS stretch only) ----------
TWILIO_ACCOUNT_SID=                # AC... from console.twilio.com, needed only when a FEATURE_* above is true
TWILIO_AUTH_TOKEN=                 # console.twilio.com, same page
TWILIO_FROM_NUMBER=                # trial number in E.164, +1...
TWILIO_SIP_TERMINATION_URI=        # <trunk-name>.pstn.twilio.com from Elastic SIP Trunking > Termination
TWILIO_SIP_USERNAME=               # credential list username
TWILIO_SIP_PASSWORD=               # credential list password
LK_OUTBOUND_TRUNK_ID=              # ST_... printed by lk sip outbound create

# ---------- Demo data ----------
DEMO_ACADEMY_NAME="Brooklyn Youth Soccer Academy"
DEMO_AGENT_PERSONA_NAME=Maya
# Seeded demo family phone (is_demo = true). Umut's own phone in E.164 so the returning-caller demo works by phone.
DEMO_RETURNING_PHONE=              # FILL  +1XXXXXXXXXX
# Second phone used only to verify a fresh (non-demo) caller in Phase 7. Not seeded. Optional.
DEMO_SECOND_PHONE=                 # +1XXXXXXXXXX

# ---------- Web (Phase 4) ----------
# Next.js token endpoint reads LIVEKIT_* above. Public URL shown on the form; filled from the purchased number in Phase 7.
NEXT_PUBLIC_LIVEKIT_PHONE_NUMBER=  # +1XXXXXXXXXX after lk number purchase
