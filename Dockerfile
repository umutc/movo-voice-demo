# syntax=docker/dockerfile:1
# LiveKit Cloud image for the enroll-agent worker (pnpm workspace).
# Generated by `lk agent dockerfile`, then adapted for this monorepo:
# - Node 24 (mise.toml pin), pnpm 12.18.0 (packageManager pin)
# - installs only the worker (agent) and its workspace dependency (db), prod deps only
# - no build step: Node 24 strips erasable TypeScript, so `node agent/src/agent.ts` runs as is
# - no `livekit-agents download-files`: the worker uses inference.VAD and
#   inference.TurnDetector and installs no @livekit/agents-plugin-* packages
ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-slim AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# The LiveKit native core reads the system trust store; the slim image does not ship it.
RUN apt-get update -qq && apt-get install --no-install-recommends -y ca-certificates && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@12.18.0

# --- Build stage ---
FROM base AS build
WORKDIR /app

# Workspace manifests first for layer caching. pnpm-workspace.yaml carries the
# reviewed build-script allowlist (allowBuilds) and the audit overrides.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY agent/package.json agent/
COPY db/package.json db/
COPY scripts/package.json scripts/
COPY eval/package.json eval/
COPY web/package.json web/

# `agent...` selects the agent package plus its workspace dependencies (db).
# --prod skips devDependencies, so no separate prune step is needed.
RUN pnpm install --frozen-lockfile --prod --filter "agent..." --filter "db..."

COPY . .

# --- Production stage ---
FROM base

ARG UID=10001
RUN adduser \
    --disabled-password \
    --gecos "" \
    --home "/app" \
    --shell "/sbin/nologin" \
    --uid "${UID}" \
    appuser

WORKDIR /app
COPY --from=build --chown=appuser:appuser /app /app
USER appuser

ENV NODE_ENV=production

# `start` connects the worker to LiveKit Cloud and waits for dispatches.
CMD ["node", "agent/src/agent.ts", "start"]
