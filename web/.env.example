# Most variables live in the repo root .env (web/next.config.ts loads it). This file lists only
# what the token endpoint (app/api/token/route.ts) needs when web/ runs on its own.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=
